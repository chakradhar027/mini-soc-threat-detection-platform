<!--
  Wazuh Custom Security Rules for Honeynet Detection
  Mapped to MITRE ATT&CK Enterprise Framework
-->

<group name="honeypot,">

  <!-- ==================== COWRIE SSH/TELNET RULES ==================== -->
  <rule id="100100" level="3">
    <decoded_as>json</decoded_as>
    <field name="eventid">^cowrie\.</field>
    <description>Cowrie honeypot interaction observed.</description>
    <mitre>
      <id>T1046</id>
    </mitre>
  </rule>

  <rule id="100101" level="5">
    <if_sid>100100</if_sid>
    <field name="eventid">cowrie.login.failed</field>
    <description>Cowrie: Authentication failed on honeypot.</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
  </rule>

  <rule id="100102" level="10" frequency="5" timeframe="60">
    <if_matched_sid>100101</if_matched_sid>
    <same_source_ip />
    <description>Cowrie: Repeated SSH brute-force attack detected (5+ failures in 60s).</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <rule id="100103" level="12">
    <if_sid>100100</if_sid>
    <field name="eventid">cowrie.login.success</field>
    <description>Cowrie: Unauthorized successful login on honeypot decoy account!</description>
    <mitre>
      <id>T1078</id>
    </mitre>
  </rule>

  <rule id="100104" level="9">
    <if_sid>100100</if_sid>
    <field name="eventid">cowrie.command.input</field>
    <description>Cowrie: Attacker command execution inside honeypot shell.</description>
    <mitre>
      <id>T1059.004</id>
    </mitre>
  </rule>

  <rule id="100105" level="14">
    <if_sid>100100</if_sid>
    <field name="eventid">cowrie.session.file_download</field>
    <description>Cowrie: Malicious payload downloaded into honeypot.</description>
    <mitre>
      <id>T1105</id>
    </mitre>
  </rule>

  <!-- ==================== DIONAEA TRAP RULES ==================== -->
  <rule id="100200" level="3">
    <decoded_as>json</decoded_as>
    <field name="service">^smb|^http|^ftp|^tftp</field>
    <description>Dionaea: Network service trap connection received.</description>
    <mitre>
      <id>T1046</id>
    </mitre>
  </rule>

  <rule id="100201" level="10">
    <if_sid>100200</if_sid>
    <field name="event_type">smb_probe</field>
    <description>Dionaea: Exploitation attempt targeting SMB (MS17-010 EternalBlue probe).</description>
    <mitre>
      <id>T1210</id>
    </mitre>
  </rule>

  <rule id="100202" level="14">
    <if_sid>100200</if_sid>
    <field name="event_type">payload_capture</field>
    <description>Dionaea: Binary malware sample captured and hashed.</description>
    <mitre>
      <id>T1204.002</id>
    </mitre>
  </rule>

  <rule id="100203" level="8">
    <if_sid>100200</if_sid>
    <field name="event_type">exploit_probe</field>
    <description>Dionaea: Web exploit probe or directory traversal attempt detected.</description>
    <mitre>
      <id>T1190</id>
    </mitre>
  </rule>

  <!-- ==================== MQTT HONEYPOT RULES ==================== -->
  <rule id="100300" level="3">
    <decoded_as>json</decoded_as>
    <field name="source_service">^mqtt_honeypot</field>
    <description>MQTT Honeypot: Rogue broker interaction.</description>
    <mitre>
      <id>T1046</id>
    </mitre>
  </rule>

  <rule id="100301" level="10">
    <if_sid>100300</if_sid>
    <field name="event_type">wildcard_subscription</field>
    <description>MQTT Honeypot: Attacker requested wildcard topic subscription (#).</description>
    <mitre>
      <id>T1046</id>
    </mitre>
  </rule>

  <rule id="100302" level="12">
    <if_sid>100300</if_sid>
    <field name="event_type">unauthorized_publish</field>
    <description>MQTT Honeypot: Rogue command injection to unauthorized control topic.</description>
    <mitre>
      <id>T1499</id>
    </mitre>
  </rule>

</group>

