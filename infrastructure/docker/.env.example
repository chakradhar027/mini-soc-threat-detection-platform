# =====================================================================
# MINI SOC & THREAT DETECTION PLATFORM - ENVIRONMENT CONFIGURATION
# =====================================================================
# Copy this file to .env before starting services:
#   cp infrastructure/docker/.env.example .env
#
# IMPORTANT: Never commit your actual .env file or API keys to Git.
# =====================================================================

# --- General System Settings ---
ENVIRONMENT=development
LOG_LEVEL=INFO
TIMEZONE=UTC

# --- PostgreSQL Relational Database ---
POSTGRES_USER=soc_admin
POSTGRES_PASSWORD=soc_secure_password_2026!
POSTGRES_DB=mini_soc
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- FastAPI SOC Backend Core ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
SECRET_KEY=mini_soc_super_secret_jwt_key_please_change_in_production_32chars!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- React SOC Frontend ---
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# --- Wazuh SIEM Core ---
WAZUH_MANAGER_HOST=127.0.0.1
WAZUH_API_PORT=55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=WazuhSecretPassword123!
WAZUH_INDEXER_HEAP_MIN=512m
WAZUH_INDEXER_HEAP_MAX=1024m

# --- Honeypot Network Port Mappings (Host Binds) ---
COWRIE_SSH_PORT=2222
COWRIE_TELNET_PORT=2223
DIONAEA_SMB_PORT=4445
DIONAEA_HTTP_PORT=8081
DIONAEA_FTP_PORT=2121
MOSQUITTO_HONEY_PORT=18883

# --- IoT Simulator & Private MQTT Broker ---
IOT_BROKER_HOST=127.0.0.1
IOT_BROKER_PORT=1883
IOT_NUM_DEVICES=10
IOT_TELEMETRY_INTERVAL_SEC=5

# --- Threat Intelligence APIs ---
# AbuseIPDB API Key (https://www.abuseipdb.com/)
ABUSEIPDB_API_KEY=
ABUSEIPDB_CONFIDENCE_THRESHOLD=50

# VirusTotal API Key (https://www.virustotal.com/)
VIRUSTOTAL_API_KEY=

# Local Cache TTL (in seconds, 86400 = 24 hours)
THREAT_INTEL_CACHE_TTL=86400

# --- SOAR Automation & Alerting ---
# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SOAR Execution Mode: 'simulation' or 'active'
# 'simulation' only logs the containment action without executing firewall drops.
SOAR_SIMULATION_MODE=true

# Response containment timeout (in seconds, e.g., 3600 = 1 hour)
SOAR_BAN_DURATION_SECONDS=3600

# --- Grafana Analytics ---
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_soc_dashboard_2026!
